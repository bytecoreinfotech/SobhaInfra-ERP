# ==============================================================================
# ERPPro / Techma Real Estate CRM & WhatsApp Automation Suite
# Environment Configuration & API Keys Reference Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Auth, RLS Multi-Tenancy) — FREE TIER
# Origin: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
# Frontend Client (Vite)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Netlify Serverless Functions (Required for server-side operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. META WHATSAPP CLOUD API (v20.0) — FREE TIER (1,000 free service convs/mo)
# Origin: https://developers.facebook.com -> My Apps -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
# Permanent System User Token or 24hr Temp Access Token
WHATSAPP_TOKEN=EAAB...your-meta-access-token...ZDZD
VITE_WHATSAPP_TOKEN=EAAB...your-meta-access-token...ZDZD

# Phone Number ID (Found in WhatsApp API Setup page)
WHATSAPP_PHONE_ID=123456789012345
VITE_WHATSAPP_PHONE_ID=123456789012345

# WhatsApp Business Account ID (WABA ID)
VITE_WHATSAPP_BUSINESS_ID=123456789012345

# Webhook Verify Token (Custom alphanumeric secret string of your choice)
# Must match the token entered in Meta Webhook Configuration panel
WHATSAPP_WEBHOOK_VERIFY_TOKEN=erppro_webhook_2026
VITE_WHATSAPP_WEBHOOK_VERIFY_TOKEN=erppro_webhook_2026

# Optional: Test phone number for development sandbox
VITE_WHATSAPP_TEST_NUMBER=+919876543210

# ------------------------------------------------------------------------------
# 3. OPENAI GPT-4o API (Bounded AI Sales Assistant Engine)
# Origin: https://platform.openai.com -> API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. TALLYPRIME LOCAL BRIDGE CONNECTOR (Local Windows Machine)
# Origin: scripts/tally-connector.js communicating with Tally on Port 9000
# ------------------------------------------------------------------------------
# Internal security token shared between local bridge and Netlify /tally-sync function
TALLY_CONNECTOR_TOKEN=erppro_tally_sec_token_2026

# Local Tally configuration
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
ERPPRO_CLOUD_URL=https://your-domain.netlify.app/.netlify/functions/tally-sync
SYNC_INTERVAL_MINS=15
ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
